# ============================================
# FreshScanner — Environment Variables
# ============================================

# KAMIS 농산물 유통정보 API (https://www.kamis.or.kr)
KAMIS_API_KEY=your_kamis_api_key_here
KAMIS_API_ID=your_kamis_api_id_here

# OpenAI API (영수증 OCR 보정, 식재료 정규화 등)
OPENAI_API_KEY=your_openai_api_key_here

# Database (기본값: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./fresh_scanner.db

# 모델 저장 경로
MODEL_DIR=./models

# 업로드 이미지 저장 경로
UPLOAD_DIR=./uploads
